rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isMember(trip) { return signedIn() && myEmail() in trip.accessEmails; }

    match /trips/{tripId} {
      function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function changedAccess() { return resource.data.access.diff(request.resource.data.access).affectedKeys(); }
      function pendingKey() { return 'pending_' + myEmail(); }

      // Read: public trips (anyone) or a member (email in accessEmails)
      allow read: if resource.data.public == true || isMember(resource.data);

      // Create: any authenticated user, must set themselves as owner
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;

      // Delete: only the owner
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      allow update: if signedIn() && (
        // Owner: anything
        request.auth.uid == resource.data.ownerId

        // Invitee resolving their own invite: swaps pending_<email> for their uid (as 'write',
        // or keeping the role they already had) and touches nothing else.
        || ( isMember(resource.data)
             && pendingKey() in resource.data.access
             && changedKeys().hasOnly(['access'])
             && changedAccess().hasOnly([pendingKey(), request.auth.uid])
             && !(pendingKey() in request.resource.data.access)
             && ( ( request.auth.uid in resource.data.access
                    && request.resource.data.access[request.auth.uid] == resource.data.access[request.auth.uid] )
                  || ( !(request.auth.uid in resource.data.access)
                       && request.resource.data.access[request.auth.uid] == 'write' ) ) )

        // Write collaborator: trip details only (not ownership, sharing, visibility or archive state)
        || ( isMember(resource.data)
             && resource.data.access.get(request.auth.uid, '') == 'write'
             && changedKeys().hasOnly([
                  'name', 'emoji', 'startDate', 'endDate', 'timezone', 'coverColor', 'partySize',
                  'city', 'cityDisplayName', 'cityLat', 'cityLng', 'cityCountry', 'cityCountryCode'
                ]) )

        // Any non-owner member leaving: removes only their own uid / pending entry and email
        || ( request.auth.uid != resource.data.ownerId
             && isMember(resource.data)
             && changedKeys().hasOnly(['access', 'accessEmails'])
             && changedAccess().hasOnly([request.auth.uid, pendingKey()])
             && !(request.auth.uid in request.resource.data.access)
             && !(pendingKey() in request.resource.data.access)
             && request.resource.data.accessEmails.toSet()
                  == resource.data.accessEmails.toSet().difference([myEmail()].toSet()) )
      );

      match /data/{docId} {
        function trip() { return get(/databases/$(database)/documents/trips/$(tripId)).data; }

        // Read: public trips (anyone) or a member
        allow read: if trip().public == true || isMember(trip());

        // Write: the owner or a member. Never deleted from the client (there is no version history).
        allow create, update: if signedIn()
          && (request.auth.uid == trip().ownerId || myEmail() in trip().accessEmails);
        allow delete: if false;
      }
    }

    // User profiles (email -> uid lookup for sharing). The stored email must be the signed-in
    // account's own, so an invite by email can't be steered to someone else's account.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 1;
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == myEmail();
      allow delete: if false;
    }

    // Feedback (bug reports & feature requests).
    // NOTE: read/update stay open only because fetch-feedback.js uses the unauthenticated client
    // SDK; lock these down once that script moves to the Admin SDK.
    match /feedback/{docId} {
      allow create: if signedIn();
      allow read, update: if true;
    }

    // Legacy collection (read-only, for migration)
    match /travel/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
